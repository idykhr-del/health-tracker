# 総合健康トラッカー — 環境変数サンプル
# 実際の値は Vercel ダッシュボード（Settings → Environment Variables）で設定する。

# ── Withings ────────────────────────────────────────────────────────────────
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# ── Upstash Redis（トークン・体組成キャッシュ・ブリーフィング本文の保存先）──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Notion ──────────────────────────────────────────────────────────────────
NOTION_API_KEY=
NOTION_BODY_DB_ID=
NOTION_SLEEP_DB_ID=
NOTION_WORKOUT_DB_ID=
NOTION_STRAVA_DB_ID=
BRIEFING_PAGE_ID=

# ── Slack ───────────────────────────────────────────────────────────────────
SLACK_RELAY_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_MENTION_USER_ID=

# ── AutoSleep 取り込み ──────────────────────────────────────────────────────
SLEEP_INGEST_TOKEN=

# ── Alexa フラッシュブリーフィング ──────────────────────────────────────────
# GET /api/post-to-slack?action=feed&k=<ここで設定した値> の認証キー。
# 値はここには書かず、32文字以上のランダム文字列を各自設定すること。
#   例: openssl rand -hex 24
ALEXA_FEED_KEY=
